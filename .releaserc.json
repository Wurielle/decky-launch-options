{
  "branches": [
    "main",
    {
      "name": "pre/rc",
      "channel": "pre/rc",
      "prerelease": "rc"
    },
    {
      "name": "beta",
      "channel": "beta",
      "prerelease": "beta"
    },
    {
      "name": "alpha",
      "channel": "alpha",
      "prerelease": "alpha"
    }
  ],
  "plugins": [
    "./.github/release/analyze.mjs",
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ]
  ]
}
